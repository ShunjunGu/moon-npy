# Repository-wide line-ending policy.
#
# This machine has core.autocrlf=true, which would rewrite LF -> CRLF on
# checkout. For a project whose core value is byte-exact NPY fixtures, that is
# unacceptable, so the policy is pinned here rather than left to local config.

# Store all text files with LF in the repository (and check out as LF) so that
# CI (Linux) and contributors (Windows/macOS) see identical bytes.
* text=auto eol=lf

# NPY fixtures are byte-exact binary artifacts. The compatibility Oracle rests
# on their sha256 staying identical across checkouts (see
# tests/fixtures/expected.json), so never apply line-ending conversion, textual
# diff, or merge to them.
*.npy binary

# Windows-specific helper scripts keep CRLF if added later.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
